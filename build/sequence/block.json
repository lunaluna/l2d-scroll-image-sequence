{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "l2d-scroll-image-sequence/sequence",
  "version": "1.0.1",
  "title": "Scroll Image Sequence Block",
  "category": "media",
  "icon": "images-alt2",
  "description": "Plays an image sequence on a canvas in sync with page scroll while the section is pinned.",
  "keywords": [
    "image sequence",
    "scroll",
    "canvas",
    "animation"
  ],
  "attributes": {
    "sequenceId": {
      "type": "number",
      "default": 0
    },
    "sequenceIdMobile": {
      "type": "number",
      "default": 0
    },
    "scrollLength": {
      "type": "number",
      "default": 1.8
    },
    "revealAt": {
      "type": "number",
      "default": 0.6
    },
    "scrollLengthMobile": {
      "type": "number",
      "default": 0
    },
    "mobileMinHeight": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "textdomain": "l2d-scroll-image-sequence",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}